# ── DB (Neon Postgres) ──
# Vercel에서 Neon을 연결하면 아래 두 값이 자동으로 들어간다. 로컬은 Neon 대시보드의 연결 문자열을 복사한다.
# pooled 연결 (호스트에 -pooler 포함) — 앱이 사용
DATABASE_URL=""
# direct 연결 (-pooler 없음) — prisma migrate가 사용
DATABASE_URL_UNPOOLED=""

# ── Auth.js ── (npx auth secret 또는 임의의 긴 문자열)
AUTH_SECRET=""

# ── 공공데이터포털 ── (비워 두면 샘플 데이터로 동작)
# 온통청년 청년정책 API 키
YOUTH_API_KEY=""
YOUTH_API_URL="https://www.youthcenter.go.kr/go/ythip/getPlcy"
# 보조금24(공공서비스) — 공공데이터포털 일반 인증키(Decoding)
GOV24_API_KEY=""
GOV24_API_URL="https://api.odcloud.kr/api/gov24/v3/serviceList"
# 한국장학재단 학자금 지원 정보 (파일데이터 자동 변환 API 주소, uddi 포함)
KOSAF_API_KEY=""
KOSAF_API_URL=""
# REST 설정 없이 공공데이터포털에서 공개 CSV를 받으려면 공식 파일 다운로드 주소를 지정합니다.
KOSAF_PUBLIC_FILE_URL=""

# ── 학교 팩트챗(FactChat) ── (학교 안내대로 채우기, 비워 두면 규칙 기반 데모 요약)
# OpenAI 호환 chat/completions 엔드포인트 전체 주소
FACTCHAT_API_URL=""
FACTCHAT_API_KEY=""
FACTCHAT_MODEL=""
# 인증 헤더 형식: 헤더 이름과 값 앞에 붙는 접두사
FACTCHAT_AUTH_HEADER="Authorization"
FACTCHAT_AUTH_PREFIX="Bearer "
# 하루 호출 한도 (90%에 도달하면 새 요약을 멈춤)
FACTCHAT_DAILY_LIMIT="1000"
# 팩트챗이 PDF를 직접 받으면 true (아니면 서버에서 텍스트 추출)
FACTCHAT_ACCEPTS_PDF="false"

# ── 알림 스케줄러 ──
# 로컬(npm run dev/start)에서는 서버 안 node-cron이 매일 09:00(KST)에 실행된다.
# Vercel에서는 자동으로 꺼지고 vercel.json의 Vercel Cron(매일 00:00 UTC = 09:00 KST)이 대신 부른다.
ENABLE_CRON="true"
# /api/cron/deadlines 호출용 비밀값 (16자 이상). Vercel에 등록하면 Vercel Cron이 자동으로 붙여 보낸다
CRON_SECRET=""
